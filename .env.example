# App
APP_NAME=chagok-chagok-api
ENV=local
API_V1_PREFIX=/api/v1

# Database (docker-compose default)
POSTGRES_USER=chagok
POSTGRES_PASSWORD=chagok
POSTGRES_DB=chagok
POSTGRES_HOST=db
POSTGRES_PORT=5432

# SQLAlchemy async URL (asyncpg) — used by the app
DATABASE_URL=postgresql+asyncpg://chagok:chagok@db:5432/chagok
# Sync URL (psycopg2) — used by alembic migrations
DATABASE_URL_SYNC=postgresql+psycopg2://chagok:chagok@db:5432/chagok

# JWT HS256 서명 키. 32바이트 이상 (짧으면 PyJWT 가 경고한다)
SECRET_KEY=change-me-local-dev-only-secret-key-32b
